{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "oneknight-static",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "serve",
        "apps/web/out",
        "-l",
        "4173",
        "--no-clipboard"
      ],
      "port": 4173
    },
    {
      "name": "oneknight-full",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/local-proxy.mjs"
      ],
      "port": 8080
    }
  ]
}
