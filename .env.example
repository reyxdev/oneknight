# Copy to .env and fill in. .env is never committed.
POSTGRES_USER=oneknight
POSTGRES_PASSWORD=change-me
POSTGRES_DB=oneknight
POSTGRES_PORT=5433

DATABASE_URL=postgres://oneknight:change-me@127.0.0.1:5433/oneknight
API_PORT=4000
API_HOST=127.0.0.1
NODE_ENV=development

# 32 random bytes, base64 (openssl rand -base64 32). Encrypts 2FA secrets at rest. Never change it without re-encrypting.
TOTP_ENC_KEY=
# Origins allowed to make state-changing requests (CSRF protection). Production: https://oneknight.pro
APP_ORIGINS=http://localhost:3000,http://localhost:8080
# Public address of the site and panel (status page check). Production: https://oneknight.pro
SITE_URL=http://localhost:8080
# true in production (HTTPS)
COOKIE_SECURE=false

# Optional: Telegram alerts about new leads. Create a bot with @BotFather, send it a message, then put
# the bot token and your chat id here. Leave empty to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Billing
GRACE_DAYS=5
# Bank details shown to clients for balance top-ups (IBAN transfer). Leave empty until they are final.
PAYMENT_RECIPIENT=
PAYMENT_IBAN=
# ЄДРПОУ / РНОКПП of the recipient
PAYMENT_TAX_ID=

# 1 = the panel is closed to everyone except ONEKNIGHT admins (no sign-ups). Tests always run with it open.
PANEL_CLOSED=1
