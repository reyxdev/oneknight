{
  "name": "@oneknight/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "start": "tsx --env-file=../../.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=../../.env src/db/migrate.ts",
    "test": "NODE_ENV=test tsx --env-file=../../.env --test src/**/*.test.ts",
    "admin:grant": "tsx --env-file=../../.env scripts/grant-admin.ts",
    "notify:test": "tsx --env-file=../../.env scripts/notify-test.ts",
    "demo:seed": "tsx --env-file=../../.env scripts/seed-demo.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@node-rs/argon2": "^2.2.1",
    "@oneknight/domain": "*",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "otplib": "^13.5.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "zod": "^4.6.5"
  }
}
